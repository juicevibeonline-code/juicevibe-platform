    "db:studio": "prisma studio --schema=../../prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
